{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "paths": {
      "@creatorem/ai-chat/component-types": ["./@types/components.d.ts"],
    },
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
